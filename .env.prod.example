# Production template. Copy to .env.prod and replace every secret before use.
APP_ENV=production
POSTGRES_USER=myreid
POSTGRES_PASSWORD=replace-db-password
POSTGRES_DB=myreid
SCENIC_POSTGRES_DB=myreid_scenic
DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}
SCENIC_DATABASE_URL=postgresql+psycopg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${SCENIC_POSTGRES_DB}
SECRET_KEY=replace-with-long-random-production-secret
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
METRICS_TOKEN=replace-with-long-random-prometheus-bearer-token
RUN_MIGRATIONS_ON_START=1
ENABLE_LEGACY_API=0
ALLOW_LOCAL_JOB_FALLBACK=0
CAMERA_AUTO_START=0
# Scenic ingestion starts independently of the admin UI / preview-only camera flag.
CORE_CAMERA_AUTO_START=1
SCENIC_CAMERA_AUTO_START=1
CAMERA_RECORDING_RETENTION_HOURS=12
CAMERA_RECORDING_SEGMENT_SECONDS=10
CAMERA_RECORDING_SEGMENT_TARGETS=0
CAMERA_RECORDING_SEGMENT_MAX_BYTES=536870912
SCENIC_ORDER_PRICE_CENTS=19900
SCENIC_ORDER_CURRENCY=CNY
PAYMENT_PROVIDER=manual
PAYMENT_PUBLIC_BASE_URL=https://api.example.com
WECHAT_PAY_APPID=
WECHAT_PAY_MCHID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_MERCHANT_SERIAL_NO=
WECHAT_PAY_MERCHANT_PRIVATE_KEY_PATH=
WECHAT_PAY_MERCHANT_PRIVATE_KEY_FILE=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_ID=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=
WECHAT_PAY_PLATFORM_PUBLIC_KEY_FILE=
GALLERY_DIR=./gallery
OBJECT_STORAGE_MODE=s3
OBJECT_STORAGE_DIR=./object_storage
MINIO_ROOT_USER=myreid
MINIO_ROOT_PASSWORD=replace-minio-password
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=myreid-media-prod
S3_ACCESS_KEY_ID=${MINIO_ROOT_USER}
S3_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
S3_REGION=us-east-1
S3_PUBLIC_BASE_URL=
S3_PRESIGNED_URL_SECONDS=900
VECTOR_BACKEND=milvus
MILVUS_URI=http://milvus:19530
MILVUS_COLLECTION=reid_clip_embeddings_prod
REDIS_URL=redis://redis:6379/0
RQ_QUEUE_NAME=media
RQ_JOB_TIMEOUT_SECONDS=21600
CLIP_MODEL_ID=openai/clip-vit-base-patch32
YOLO_MODEL_PATH=/models/yolov8n.pt
MODEL_SERVICE_BACKEND=baseline
EMBEDDING_BACKEND=clipreid
DETECTION_BACKEND=yolo
EMBEDDING_DIMENSION=512
MODEL_DEVICE=cpu
CLIPREID_MODEL_PATH=/models/ViT-MSMT17-60.pth
CLIPREID_IMAGE_HEIGHT=336
CLIPREID_IMAGE_WIDTH=160
CUSTOM_REID_MODEL_PATH=
CUSTOM_DETECTION_MODEL_PATH=
ONNX_MODEL_PATH=
ONNX_DETECTION_MODEL_PATH=
TENSORRT_ENGINE_PATH=
TENSORRT_DETECTION_ENGINE_PATH=
GPU_INFERENCE_URL=
EMAIL_CODE_DEV_MODE=0
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=sender@example.com
SMTP_PASSWORD=replace-smtp-password
SMTP_FROM=sender@example.com
SMTP_USE_TLS=1
LOG_LEVEL=INFO
DISK_ALERT_FREE_PERCENT=15
DISK_ALERT_FREE_BYTES=2147483648
MAX_UPLOAD_MB=1024

# Complete backend settings (defaults; see docs/CONFIGURATION_REFERENCE.md)
APP_NAME=行人重识别系统
API_V1_PREFIX=/api/v1
PUBLIC_REGISTRATION_ROLE=viewer
CAMERA_SOURCES={"0":"0"}
VISITOR_REQUIRE_STAFF_VERIFICATION=1
VISITOR_OPERATIONS_PER_HOUR=30
VISITOR_PROJECT_OPERATIONS_PER_HOUR=300
VISITOR_RETENTION_DAYS=30
SCENIC_EDITING_ENABLED=1
SCENIC_TRACKING_ENABLED=0
VISITOR_AUTH_PROVIDER=wechat
VISITOR_PAYMENT_PROVIDER=manual
VISITOR_TEST_INVITE_CODE=
VISITOR_WECHAT_APPID=
VISITOR_WECHAT_SECRET=
VISITOR_PUBLIC_BASE_URL=
VISITOR_COOKIE_SECURE=1
VISITOR_ALLOW_LAN_HTTP=0
VISITOR_AUTO_PUBLISH=0
VISITOR_AUTO_SIMILARITY=0.9
VISITOR_INDEX_WAIT_SECONDS=600
SCENIC_PUBLIC_BASE_URL=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080
ASSET_URL_TTL_SECONDS=300
REDIS_CONNECT_TIMEOUT_SECONDS=1.0
REDIS_SOCKET_TIMEOUT_SECONDS=2.0
REALTIME_ENTER_THRESHOLD=0.65
REALTIME_EXIT_THRESHOLD=0.55
REALTIME_MARGIN=0.08
REALTIME_ORIGINS=http://localhost:15173,http://127.0.0.1:15173,http://localhost:35173,http://127.0.0.1:35173,http://localhost:5173,http://127.0.0.1:5173,http://tauri.localhost,https://tauri.localhost,tauri://localhost
CLIPREID_MODEL_NAME=ViT-B-16
CLIPREID_DATASET_NAME=MSMT17
CLIPREID_NUM_CLASSES=1041
CLIPREID_CAMERA_NUM=15
CLIPREID_VIEW_NUM=1
CLIPREID_STRIDE_SIZE=16
SMTP_USE_SSL=0
EMAIL_CODE_TTL_MINUTES=10
SCENIC_DELIVERY_TOKEN_TTL_HOURS=720

# Runtime / launcher options (export these when launching Python directly)
CLIP_CACHE_DIR=
YOLO_CONFIG_DIR=
MYREID_CAMERA_SOURCE=0
MYREID_CAMERA_BRIDGE_DIR=
SCENIC_FONT_FILE=
SCENIC_FONT_FAMILY=Noto Sans CJK SC
SCENIC_VIDEO_ENCODER=libx264
LOCAL_JOB_RECORD_LIMIT=10000
JOB_RECORD_TTL_SECONDS=604800
LOCAL_JOB_WORKERS=4
LOCAL_JOB_QUEUE_LIMIT=128
MYREID_API_PORT=2889
MYREID_DB_WAIT_SECONDS=60
VITE_MYREID_API_BASE_URL=https://api.example.com
VISITOR_WEB_PORT=15174
WORKER_MODEL_DEVICE=cpu
MYREID_ENV_FILE=.env.prod
MYREID_COMPOSE_ENV_FILE=
MYREID_COMPOSE_FILES=
INSTALL_SCENIC_TRACKING=0
STAFF_WEB_PORT=15173

# Optional docker-compose.https.yml gateway (real DNS names, no URL scheme)
STAFF_DOMAIN=
VISITOR_DOMAIN=
ACME_EMAIL=

# Shared low-latency camera capture and preview (restart backend/bridge after changes).
CAMERA_CAPTURE_WIDTH=640
CAMERA_CAPTURE_HEIGHT=480
CAMERA_PREVIEW_FPS=30
CAMERA_PREVIEW_WIDTH=640
CAMERA_JPEG_QUALITY=75
REALTIME_CAMERA_INFERENCE_FPS=30
# auto: CUDA FP16, CPU/MPS FP32. ViT INT8 is CPU-only and requires accuracy validation.
YOLO_PRECISION=auto
YOLO_IMAGE_SIZE=640
CLIPREID_PRECISION=auto
